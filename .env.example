# ==============================================================================
# Bublik VPN Bot — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Only Telegram Stars payments are supported.
# ==============================================================================

# --- Telegram Bot ---
BOT_TOKEN=your_bot_token_here                       # Bot token from @BotFather
TELEGRAM_PROXY_URL=                                 # Optional: proxy for Telegram API (socks5://host:port)
ADMIN_IDS=123456789                                 # Comma-separated admin Telegram IDs
DEFAULT_LANGUAGE=ru                                 # Default language: "ru" or "en"

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=remnawave-tg-shop-db                  # Docker service name
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# --- Remnawave Panel ---
PANEL_API_URL=https://panel.example.com/api         # Panel API base URL
PANEL_API_KEY=your_panel_api_key                    # Panel API token (Bearer)
PANEL_WEBHOOK_SECRET=                               # Secret for verifying panel webhook signatures
USER_SQUAD_UUIDS=                                   # Optional: comma-separated internal squad UUIDs
USER_EXTERNAL_SQUAD_UUID=                           # Optional: external squad UUID
USER_TRAFFIC_STRATEGY=NO_RESET                      # Traffic reset strategy (NO_RESET, WEEK, MONTH)

# --- Webhook (for production) ---
# Leave WEBHOOK_BASE_URL empty to run in polling mode (for development/testing)
WEBHOOK_BASE_URL=                                   # e.g. https://bot.example.com
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=                            # Secret for Telegram webhook validation

# ==============================================================================
# TRAFFIC PACKAGES (main pricing configuration)
# ==============================================================================
# Format: "GB:stars_price:days" (comma-separated)
# Example: 15 GB for 100 stars valid 15 days, 50 GB for 200 stars valid 30 days, etc.
TRAFFIC_PACKAGES=15:100:15,50:200:30,120:400:30,250:700:60

# --- Payment (Telegram Stars only) ---
STARS_ENABLED=True
STARS_PROVIDER_TOKEN=                               # Leave empty for Telegram Stars (XTR)

# ==============================================================================
# TRIAL
# ==============================================================================
TRIAL_ENABLED=True                                  # Enable free trial for new users
TRIAL_DURATION_DAYS=2                               # Trial duration in days
TRIAL_TRAFFIC_LIMIT_GB=1                            # Trial traffic limit in GB

# ==============================================================================
# REFERRAL PROGRAM
# ==============================================================================
REFERRAL_ENABLED=True                               # Enable referral system
REFERRAL_ONE_BONUS_PER_REFEREE=True                 # Bonus only on first payment of referred user
LEGACY_REFS=True                                    # Allow old ref_<tg_id> referral links

# Bonus for the inviting user (when friend makes first purchase)
REFERRAL_INVITER_BONUS_GB=3                         # GB bonus for inviter
REFERRAL_INVITER_BONUS_DAYS=7                       # Days for inviter bonus

# Bonus for the invited user (on first purchase)
REFERRAL_REFEREE_BONUS_GB=3                         # GB bonus for referee
REFERRAL_REFEREE_BONUS_DAYS=7                       # Days for referee bonus

# ==============================================================================
# NOTIFICATIONS
# ==============================================================================
SUBSCRIPTION_NOTIFICATIONS_ENABLED=True             # Enable subscription expiry notifications
SUBSCRIPTION_NOTIFY_ON_EXPIRE=True                  # Notify before subscription expires
SUBSCRIPTION_NOTIFY_AFTER_EXPIRE=True               # Notify after subscription expires
SUBSCRIPTION_NOTIFY_DAYS_BEFORE=3                   # Days before expiry to send notification

# Traffic usage notifications
TRAFFIC_NOTIFICATION_THRESHOLD=0.9                  # Alert when usage >= 90% (0.0-1.0)
TRAFFIC_NOTIFICATION_CHECK_INTERVAL_MINUTES=60      # How often to check (minutes)

# ==============================================================================
# UI & FEATURES
# ==============================================================================
SUPPORT_LINK=https://t.me/your_support              # Support chat link (shown in menu)
SERVER_STATUS_URL=                                  # Optional: server status page URL
TERMS_OF_SERVICE_URL=                               # Optional: terms of service URL
SUBSCRIPTION_MINI_APP_URL=                          # Optional: mini-app for subscription management
START_COMMAND_DESCRIPTION=                          # Optional: /start command description
DISABLE_WELCOME_MESSAGE=False                       # Skip welcome message on /start

# Device management
MY_DEVICES_SECTION_ENABLED=False                    # Show "My Devices" in subscription menu
USER_HWID_DEVICE_LIMIT=0                            # Device limit per user (0 = unlimited)

# Required channel gate
REQUIRED_CHANNEL_SUBSCRIBE_TO_USE=False             # Require channel subscription to use bot
REQUIRED_CHANNEL_ID=                                # Channel ID (e.g. -1001234567890)
REQUIRED_CHANNEL_LINK=                              # Channel invite link for join button

# Connection link encryption (Happ crypt4)
CRYPT4_ENABLED=False
CRYPT4_REDIRECT_URL=                                # Base redirect URL for encrypted links

# ==============================================================================
# ADMIN LOGGING
# ==============================================================================
LOG_LEVEL=INFO                                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_CHAT_ID=                                        # Telegram chat/group for admin notifications
LOG_THREAD_ID=                                      # Optional: thread ID for supergroup
LOG_NEW_USERS=True                                  # Notify on new registrations
LOG_PAYMENTS=True                                   # Notify on payments
LOG_PROMO_ACTIVATIONS=True                          # Notify on promo activations
LOG_TRIAL_ACTIVATIONS=True                          # Notify on trial activations
LOG_SUSPICIOUS_ACTIVITY=True                        # Notify on suspicious activity

# Log storage
LOG_STORE_MESSAGE_CONTENT=False                     # Store message content in DB
LOG_STORE_RAW_UPDATES=False                         # Store raw update payloads
LOG_EXPORT_INCLUDE_SENSITIVE=False                   # Include sensitive data in CSV export
LOG_ADMIN_HIDE=False                                # Hide admin events from logs UI
LOGS_PAGE_SIZE=10                                   # Events per page in admin log

# Promo discount timeout
DISCOUNT_PROMO_PAYMENT_TIMEOUT_MINUTES=10           # Minutes to keep discount reservation

# ==============================================================================
# WEB SERVER (for webhooks)
# ==============================================================================
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# ==============================================================================
# INLINE MODE THUMBNAILS (don't change unless you know what this is)
# ==============================================================================
INLINE_REFERRAL_THUMBNAIL_URL=https://cdn-icons-png.flaticon.com/512/1077/1077114.png
INLINE_USER_STATS_THUMBNAIL_URL=https://cdn-icons-png.flaticon.com/512/681/681494.png
INLINE_FINANCIAL_STATS_THUMBNAIL_URL=https://cdn-icons-png.flaticon.com/512/2769/2769339.png
INLINE_SYSTEM_STATS_THUMBNAIL_URL=https://cdn-icons-png.flaticon.com/512/2920/2920277.png
